# Copie este arquivo para .env e ajuste os valores.
# Para continuar usando o volume de desenvolvimento atual do Windows,
# mantenha temporariamente a senha que já foi usada na criação do banco.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUBSTITUA_PELA_SENHA_ATUAL_DO_SEU_BANCO
POSTGRES_DB=pacs_db

# Para executar Node.js diretamente no Windows:
DB_HOST=localhost
DB_PORT=5433
PORT=3000
